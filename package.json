{
  "name": "paylo-mcp-server",
  "version": "0.1.1",
  "description": "Universal commerce protocol for AI agents to browse, search, and interact with Paylo stores",
  "keywords": [
    "paylo",
    "commerce",
    "mcp",
    "model context protocol",
    "ai-shopping"
  ],
  "author": "Paylo",
  "license": "MIT",
  "type": "module",
  "bin": {
    "paylo-mcp-server": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');fs.chmodSync('build/index.js','755');fs.copyFileSync('favicon.ico','build/favicon.ico')\"",
    "prepare": "npm run build",
    "mcp": "tsx src/server.ts",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/index.js",
    "test": "tsx --test tests/*.test.ts",
    "test-services": "node test-services.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
